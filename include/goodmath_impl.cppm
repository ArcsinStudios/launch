	export double mod(double x, double y);

	export long long gcd(long long x, long long y);

	export long long lcm(long long x, long long y);

	export double sqrt(double x);

	export double cbrt(double x);

	export double nrt(double x, double y);

	export double exp(double x);

	export double ln(double x);

	export double lg(double x);

	export double log2(double x);

	export double log(double x, double y);

	export double hypot(double x, double y);

	export double dtor(double deg);

	export double rtod(double rad);

	export double sin(double x);

	export double cos(double x);

	export double tan(double x);

	export double arcsin(double x);

	export double arccos(double x);

	export double arctan(double x);

	export double arctan2(double y, double x);

